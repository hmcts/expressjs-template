{
  "name": "rpe-expressjs-template",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "clean:assets": "mkdir -p src/main/public && find src/main/public -maxdepth 1 -type f \\( -name 'main*.css' -o -name 'main*.js' -o -name 'main*.js.LICENSE.txt' \\) -delete",
    "build:assets:dev": "yarn clean:assets && webpack --mode development --config webpack.config.js",
    "build:assets": "yarn clean:assets && NODE_ENV=production webpack --mode production --config webpack.config.js",
    "build:server": "tsc -p tsconfig.build.json",
    "copy:server-assets": "mkdir -p dist/main && cp -R src/main/views dist/main/views && cp -R src/main/public dist/main/public",
    "build": "yarn clean && yarn build:assets && yarn build:server && yarn copy:server-assets",
    "build:prod": "yarn build",
    "start": "NODE_ENV=production node --enable-source-maps dist/main/server.js",
    "start:dev": "./bin/generate-ssl-options.sh && tsx watch --clear-screen=false src/main/server.ts",
    "lint": "stylelint **/*.scss -v -q && eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run src/test/unit",
    "test:coverage": "vitest run src/test/unit --coverage",
    "test:routes": "vitest run src/test/routes",
    "test:a11y": "playwright test --project=accessibility",
    "test:smoke": "NODE_EXTRA_CA_CERTS=src/main/resources/localhost-ssl/localhost.crt vitest run --config vitest.smoke.config.ts",
    "test:functional": "playwright test --project=chromium",
    "test:functional:headed": "TEST_HEADLESS=false playwright test --project=chromium",
    "test:functional:debug": "playwright test --project=chromium --debug",
    "cichecks": "yarn typecheck && yarn build && yarn lint && yarn test && yarn test:a11y && yarn test:functional",
    "postinstall": "node .husky/install.mjs"
  },
  "dependencies": {
    "@hmcts/info-provider": "^1.4.0",
    "@hmcts/nodejs-healthcheck": "1.8.6",
    "@hmcts/properties-volume": "1.4.1",
    "applicationinsights": "3.15.1",
    "config": "4.4.2",
    "express": "5.2.1",
    "express-rate-limit": "^8.6.1",
    "govuk-frontend": "6.4.0",
    "helmet": "8.3.0",
    "nunjucks": "3.2.4",
    "serve-favicon": "2.5.1",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.0",
    "@types/express": "5.0.6",
    "@types/node": "^24.13.3",
    "@types/nunjucks": "3.2.6",
    "@types/serve-favicon": "^2.5.7",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.24",
    "chokidar": "^3.6.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.8.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "mini-css-extract-plugin": "^2.10.2",
    "playwright-core": "1.62.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "supertest": "^7.2.2",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "4.1.10",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1",
    "webpack-dev-middleware": "^8.1.0"
  },
  "lint-staged": {
    "**/*.{js,cjs,mjs,ts,cts,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "**/*.{css,json,json5,jsonc,yaml,yml,md,mdx,html}": "prettier --write"
  },
  "packageManager": "yarn@4.17.1"
}
