{
  "name": "rpe-expressjs-template",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "clean:assets": "mkdir -p src/main/public && find src/main/public -maxdepth 1 -type f \\( -name 'main*.css' -o -name 'main*.js' -o -name 'main*.js.LICENSE.txt' \\) -delete",
    "build:assets:dev": "yarn clean:assets && webpack --mode development --config webpack.config.js",
    "build:assets": "yarn clean:assets && NODE_ENV=production webpack --mode production --config webpack.config.js",
    "build:server": "tsc -p tsconfig.build.json",
    "copy:server-assets": "mkdir -p dist/main && cp -R src/main/views dist/main/views && cp -R src/main/public dist/main/public",
    "build": "yarn clean && yarn build:assets && yarn build:server && yarn copy:server-assets",
    "build:prod": "yarn build",
    "start": "NODE_ENV=production node --enable-source-maps dist/main/server.js",
    "start:dev": "./bin/generate-ssl-options.sh && tsx watch --clear-screen=false src/main/server.ts",
    "lint": "stylelint **/*.scss -v -q && eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write . .github",
    "test": "yarn test:unit && yarn test:routes",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "test:routes": "jest -c jest.routes.config.js",
    "test:a11y": "jest --detectOpenHandles -c jest.a11y.config.js --maxWorkers 15",
    "test:smoke": "NODE_EXTRA_CA_CERTS=src/main/resources/localhost-ssl/localhost.crt jest -c jest.smoke.config.js",
    "test:functional": "playwright test --project=chromium",
    "test:functional:headed": "TEST_HEADLESS=false playwright test --project=chromium",
    "test:functional:debug": "playwright test --project=chromium --debug",
    "cichecks": "yarn install --immutable && yarn typecheck && yarn build && yarn lint && yarn test && yarn test:a11y && yarn test:functional",
    "postinstall": "node .husky/install.mjs"
  },
  "dependencies": {
    "@hmcts/info-provider": "^1.4.0",
    "@hmcts/nodejs-healthcheck": "1.8.6",
    "@hmcts/nodejs-logging": "4.0.4",
    "@hmcts/properties-volume": "1.4.1",
    "applicationinsights": "2.7.0",
    "config": "3.3.12",
    "express": "5.2.1",
    "express-rate-limit": "^7.5.0",
    "govuk-frontend": "6.4.0",
    "helmet": "8.1.0",
    "nunjucks": "3.2.4",
    "serve-favicon": "2.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.60.0",
    "@types/config": "3.3.5",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/nunjucks": "3.2.6",
    "@types/serve-favicon": "^2.5.7",
    "@types/supertest": "^6.0.3",
    "chokidar": "^3.6.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.8.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-html-reporter": "^4.4.0",
    "jest-util": "^30.4.1",
    "lint-staged": "^17.2.0",
    "mini-css-extract-plugin": "^2.10.2",
    "playwright-core": "1.60.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1",
    "webpack-dev-middleware": "^8.1.0"
  },
  "lint-staged": {
    "**/*.{js,cjs,mjs,ts,cts,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "**/*.{css,json,json5,jsonc,yaml,yml,md,mdx,html}": "prettier --write"
  },
  "resolutions": {
    "form-data": "^4.0.1",
    "js-yaml": "^4.1.1"
  },
  "packageManager": "yarn@4.8.1"
}
