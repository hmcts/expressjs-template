{
  "name": "rpe-expressjs-template",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "clean:assets": "mkdir -p src/main/public && find src/main/public -maxdepth 1 -type f \\( -name 'main*.css' -o -name 'main*.js' -o -name 'main*.js.LICENSE.txt' \\) -delete",
    "build:assets:dev": "yarn clean:assets && webpack --mode development --config webpack.config.js",
    "build:assets": "yarn clean:assets && NODE_ENV=production webpack --mode production --config webpack.config.js",
    "build:server": "tsc -p tsconfig.build.json",
    "copy:server-assets": "mkdir -p dist/main && cp -R src/main/views dist/main/views && cp -R src/main/public dist/main/public",
    "build": "yarn clean && yarn build:assets && yarn build:server && yarn copy:server-assets",
    "build:prod": "yarn build",
    "start": "NODE_ENV=production node --enable-source-maps dist/main/server.js",
    "start:dev": "nodemon --config nodemon.json",
    "lint": "stylelint **/*.scss -v -q && eslint . --ext .js,.ts && prettier --check .",
    "lint:fix": "prettier --write . .github && eslint --fix .",
    "test": "yarn test:unit",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "test:routes": "jest -c jest.routes.config.js",
    "test:a11y": "jest --detectOpenHandles -c jest.a11y.config.js --maxWorkers 15",
    "test:smoke": "NODE_EXTRA_CA_CERTS=src/main/resources/localhost-ssl/localhost.crt jest -c jest.smoke.config.js",
    "test:functional": "playwright test --project=chromium",
    "test:functional:headed": "TEST_HEADLESS=false playwright test --project=chromium",
    "test:functional:debug": "playwright test --project=chromium --debug",
    "cichecks": "yarn install --immutable && yarn typecheck && yarn build && yarn lint && yarn test && yarn test:routes && yarn test:a11y && yarn test:functional",
    "prepare": "husky install"
  },
  "dependencies": {
    "@hmcts/info-provider": "^1.4.0",
    "@hmcts/nodejs-healthcheck": "1.8.6",
    "@hmcts/nodejs-logging": "4.0.4",
    "@hmcts/properties-volume": "1.4.1",
    "applicationinsights": "2.7.0",
    "config": "3.3.12",
    "express": "5.2.1",
    "express-rate-limit": "^7.5.0",
    "govuk-frontend": "^5.9.0",
    "helmet": "8.1.0",
    "jquery": "3.7.1",
    "nunjucks": "3.2.4",
    "serve-favicon": "2.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/core": "^7.26.10",
    "@babel/eslint-parser": "7.28.0",
    "@babel/preset-env": "^7.26.9",
    "@playwright/test": "1.60.0",
    "@types/chai": "^5.2.1",
    "@types/chai-as-promised": "7.1.8",
    "@types/config": "3.3.5",
    "@types/es6-promisify": "6.0.4",
    "@types/express": "5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22",
    "@types/nunjucks": "3.2.6",
    "@types/serve-favicon": "^2.5.7",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "babel-loader": "9.2.1",
    "chai": "4.5.0",
    "chai-as-promised": "7.1.2",
    "chokidar": "^3.6.0",
    "copy-webpack-plugin": "9.1.0",
    "css-loader": "6.11.0",
    "debug": "4.4.3",
    "eslint": "8.57.1",
    "eslint-config-prettier": "8.8.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-jest": "^29.0.1",
    "html-webpack-plugin": "5.5.1",
    "husky": "8.0.3",
    "jest": "^29.4.0",
    "jest-html-reporter": "3.10.2",
    "jest-junit": "16.0.0",
    "jest-util": "^29",
    "lint-staged": "13.2.2",
    "mini-css-extract-plugin": "2.7.6",
    "nock": "13.3.1",
    "nodemon": "2.0.22",
    "playwright": "1.60.0",
    "playwright-core": "1.60.0",
    "postcss": "^8.4.27",
    "prettier": "2.8.8",
    "sass": "1.77.8",
    "sass-loader": "13.3.3",
    "style-loader": "3.3.4",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.4",
    "ts-node": "10.9.2",
    "typescript": "~5.9.3",
    "webpack": "5.94.0",
    "webpack-cli": "5.1.4",
    "webpack-dev-middleware": "6.1.3",
    "webpack-node-externals": "3.0.0"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown",
    "**/*.{js,ts}": "eslint --fix"
  },
  "resolutions": {
    "form-data": "^4.0.1",
    "js-yaml": "^4.1.1"
  },
  "packageManager": "yarn@4.8.1"
}
