{
  "compilerOptions": {
    "module": "Node20",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "isolatedModules": true,
    "noImplicitThis": false,
    "noUnusedLocals": true,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "playwright.config.ts", "vitest.config.ts", "vitest.smoke.config.ts"],
  "exclude": ["dist", "**/__mocks__/*"]
}
